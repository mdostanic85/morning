# Copy to .env.local and fill in what you need. Connector credentials (Google
# OAuth, Jira, Figma, GitHub, Discord) are configured on the Settings page and
# stored encrypted in the database, so they are not listed here.

# Required — the app refuses to start without it.
DATABASE_URL=postgresql://worklight:worklight@127.0.0.1:5433/worklight

# Required — seals connector tokens before they are written to the database.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Rotating it makes every stored token unreadable; reconnect each provider after.
SECRETS_ENCRYPTION_KEY=

# Google login (Clerk). Provisioned via Vercel Marketplace (`vercel integration add clerk`)
# or from https://dashboard.clerk.com — never expose CLERK_SECRET_KEY to the client.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/sign-in
# Enable Email + Password under Clerk Dashboard → User & Authentication →
# Email, phone, username. Optionally enable Google under Social connections.

# Primary text model for every job that reads your own work content.
GROQ_API_KEY=
# Embeddings for knowledge search, plus a text fallback.
OPENAI_API_KEY=
# Optional text fallback.
ANTHROPIC_API_KEY=

# Public research / cheap bulk LLM (Gemini). Used only for public material you
# paste in yourself — never for your sources. Key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Optional override (default: gemini-3.1-flash-lite)
# PUBLIC_LLM_MODEL=gemini-3.1-flash-lite

# Optional local OpenAI-compatible endpoint (Ollama, MLX, ...), last fallback.
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_LLM_MODEL=qwen3.6:35b
# LOCAL_LLM_API_KEY=

# Required only for hosted Hydra cron scheduling.
# CRON_SECRET=
