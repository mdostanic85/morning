{
  "name": "worklight-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "INNGEST_DEV=1 concurrently -n next,inngest -c blue,magenta \"npm run dev:next\" \"npm run dev:inngest\"",
    "dev:next": "INNGEST_DEV=1 next dev",
    "dev:inngest": "inngest-cli dev -u http://127.0.0.1:3000/api/inngest",
    "dev:all": "npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && npm run check:css",
    "check:css": "node scripts/check-css-architecture.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:pg:generate": "DATABASE_URL=postgresql://worklight:worklight@127.0.0.1:5433/worklight drizzle-kit generate",
    "db:pg:migrate": "npm run docker:pg:up && DATABASE_URL=postgresql://worklight:worklight@127.0.0.1:5433/worklight drizzle-kit migrate",
    "db:migrate:sqlite-to-postgres": "npm run docker:pg:up && DATABASE_URL=postgresql://worklight:worklight@127.0.0.1:5433/worklight tsx scripts/migrate-sqlite-to-postgres.mts",
    "test:db-query": "tsx --test src/db/query.test.mts",
    "test:connection-cursors": "tsx --test src/lib/imports/connectionCursorUtils.test.mts src/lib/imports/jiraConnectionCursor.test.mts src/lib/imports/gmailConnectionCursor.test.mts src/lib/imports/resourceConnectionCursor.test.mts",
    "test:gmail-gemini": "node --conditions=react-server --test --import tsx src/lib/connectors/gmail.test.mts",
    "test:sync-run-completion": "tsx --test src/lib/imports/syncRunCompletion.test.mts",
    "test:p1-3-postgres": "node --env-file-if-exists=.env.local --conditions=react-server --test --import tsx src/services/syncRuns.p1-3.test.ts",
    "test:p1-3": "npm run test:sync-run-completion && npm run test:p1-3-postgres && npm run test:sync-provider-status",
    "test:sync-provider-status": "tsx --test src/lib/imports/syncProvider.test.mts",
    "test:redact": "tsx --test src/lib/llm/redact.test.mts",
    "test:llm-contract": "node --conditions=react-server --test --import tsx src/lib/llm/openaiCompatible.test.mts",
    "test:gemini": "node --conditions=react-server --test --import tsx src/lib/llm/gemini.test.mts",
    "test:model-capabilities": "tsx --test src/lib/llm/modelCapabilities.test.mts",
    "test:source-content-hash": "tsx --test src/lib/imports/sourceContentHash.test.mts",
    "test:confidence-model": "tsx --test src/lib/tasks/confidenceModel.test.mts src/lib/tasks/taskConfidence.test.mts",
    "test:conflict-detection": "tsx --test src/lib/tasks/conflictDetection.test.mts",
    "test:task-supporting-sources": "tsx --test src/lib/tasks/taskSupportingSources.test.mts",
    "test:evidence-relevance": "tsx --test src/lib/tasks/evidenceRelevance.test.mts",
    "test:ingestion-rules": "tsx --test src/lib/tasks/ingestionRuleMatch.test.mts",
    "test:person-identity": "tsx --test src/lib/tasks/personIdentity.test.mts",
    "test:extraction-reflect": "tsx --test src/lib/tasks/evidenceVerification.test.mts src/lib/tasks/reflectDecisions.test.mts",
    "test:blocked-waiting-dedupe": "tsx --test src/lib/dailyBrief/blockedWaitingDedupe.test.mts",
    "test:needs-input-relevance": "tsx --test src/lib/dailyBrief/needsInputRelevance.test.mts",
    "test:source-authority": "tsx --test src/lib/tasks/sourceAuthority.test.mts",
    "test:transcript-merge": "tsx --test src/lib/tasks/transcriptTaskMerge.test.mts",
    "test:jira-anchor-evidence": "tsx --test src/lib/tasks/jiraAnchorEvidence.test.mts",
    "test:planner-confidence": "tsx --test src/lib/tasks/plannerConfidence.test.mts",
    "test:task-visibility": "tsx --test src/lib/tasks/taskVisibility.test.mts src/lib/filters/ownerFilter.test.mts",
    "test:jul20-brief": "tsx --test src/lib/dailyBrief/jul20Scenario.test.mts",
    "test:canonical-lifecycle": "tsx --test src/lib/tasks/canonicalLifecycle.test.mts",
    "test:completion-evidence": "tsx --test src/lib/tasks/completionEvidence.test.mts",
    "test:ownership-decision": "tsx --test src/lib/tasks/ownershipDecision.test.mts",
    "test:criterion-evidence": "tsx --test src/lib/tasks/criterionEvidence.test.mts",
    "test:criterion-verification-match": "tsx --test src/lib/tasks/criterionVerificationMatch.test.mts",
    "test:figma-url": "tsx --test src/lib/connectors/figmaUrl.test.mts",
    "test:figma-discover": "tsx --test src/lib/figma/discoverFigmaFileKeys.test.mts",
    "test:figma-comment-merge": "tsx --test src/lib/tasks/figmaCommentMerge.test.mts src/lib/connectors/figmaComments.test.mts",
    "test:figma-comment-thread": "tsx --test src/lib/figma/commentThread.test.mts",
    "test:figma-coverage": "tsx --test src/lib/dailyBrief/coverage.test.mts",
    "test:high-authority-people": "tsx --test src/lib/tasks/highAuthorityPeople.test.mts",
    "test:owner-filter": "tsx --test src/lib/filters/ownerFilter.test.mts",
    "test:project-for-jira-key": "tsx --test src/lib/projects/projectForJiraKey.test.mts",
    "test:delivery-links": "tsx --test src/lib/tasks/deliveryLinks.test.mts src/lib/tasks/deliveryAuditSelection.test.mts src/lib/connectors/mcp/adapters/jiraIssueCandidate.test.mts src/lib/llm/prompts/deliverySyncReview.test.mts",
    "test": "npm run test:db-query && npm run test:connection-cursors && npm run test:gmail-gemini && npm run test:sync-run-completion && npm run test:sync-provider-status && npm run test:redact && npm run test:llm-contract && npm run test:gemini && npm run test:model-capabilities && npm run test:source-content-hash && npm run test:confidence-model && npm run test:conflict-detection && npm run test:task-supporting-sources && npm run test:evidence-relevance && npm run test:ingestion-rules && npm run test:person-identity && npm run test:extraction-reflect && npm run test:blocked-waiting-dedupe && npm run test:source-authority && npm run test:transcript-merge && npm run test:jira-anchor-evidence && npm run test:planner-confidence && npm run test:task-visibility && npm run test:jul20-brief && npm run test:canonical-lifecycle && npm run test:completion-evidence && npm run test:ownership-decision && npm run test:criterion-evidence && npm run test:criterion-verification-match && npm run test:figma-url && npm run test:figma-discover && npm run test:figma-comment-merge && npm run test:figma-comment-thread && npm run test:figma-coverage && npm run test:high-authority-people && npm run test:owner-filter && npm run test:project-for-jira-key && npm run test:delivery-links",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docker:pg:up": "docker compose up -d --wait postgres",
    "docker:pg:down": "docker compose down",
    "docker:pg:logs": "docker compose logs -f postgres"
  },
  "dependencies": {
    "@heroui/react": "3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.42.2",
    "inngest": "^4.13.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "playwright": "^1.56.0",
    "postgres": "^3.4.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.81.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "inngest-cli": "^1.38.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  }
}
